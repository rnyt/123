# Скопируй этот файл в .env и впиши свои значения.

# Токен бота от @BotFather (обязательно): /newbot → скопируй строку вида 1234567890:AAH...
BOT_TOKEN=

# Часовой пояс по умолчанию для новых пользователей (в боте его можно поменять).
DEFAULT_TZ=Europe/Minsk

# Личный режим: id пользователей через запятую (свой id подскажет @userinfobot).
# Пусто — ботом может пользоваться любой (у каждого свои данные).
ALLOWED_USERS=

# Где хранить базу. По умолчанию — data/grades.db рядом с ботом.
DB_PATH=data/grades.db

# Прокси до api.telegram.org, если без него не подключается: http://user:pass@host:port
PROXY_URL=

# Подробность логов: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
