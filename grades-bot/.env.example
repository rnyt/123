# Скопируй этот файл в .env и впиши свои значения (или просто запусти start.bat / start.sh —
# бот сам спросит токен и создаст .env). Файл .env не попадает в git.

# Токен бота от @BotFather (обязательно): /newbot → скопируй строку вида 1234567890:AAH...
BOT_TOKEN=

# Владелец бота (юзернейм без @ или числовой id): ему доступна /apanel.
# При первом входе бот запоминает его id — сменить юзернейм владельцу можно без риска.
OWNER=ztpst

# Часовой пояс по умолчанию для новых пользователей (в боте его можно поменять).
DEFAULT_TZ=Europe/Minsk

# Дополнительно разрешённые id через запятую (обычно не нужно — приглашай через /apanel).
ALLOWED_USERS=

# Где хранить базу. По умолчанию — data/grades.db рядом с ботом. Это и есть резервная копия.
DB_PATH=data/grades.db

# Прокси до api.telegram.org, если без него не подключается: http://user:pass@host:port
PROXY_URL=

# Подробность логов: DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# Экономия памяти: ~75 МБ вместо ~170 МБ (нужно для бесплатных хостингов со 128 МБ). 0 — выключить.
LOW_MEMORY=1

# Свой сервер Bot API (обычно не нужен): http://localhost:8081
TELEGRAM_API_URL=
